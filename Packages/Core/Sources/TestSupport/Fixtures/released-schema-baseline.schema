table	absWatchCopy	CREATE TABLE "absWatchCopy" ("accountId" INTEGER NOT NULL REFERENCES "account"("id") ON DELETE CASCADE, "itemId" TEXT NOT NULL, "episodeId" TEXT NOT NULL DEFAULT '', "title" TEXT NOT NULL, "subtitle" TEXT, "watchInstallID" TEXT, "revision" INTEGER NOT NULL, "state" TEXT NOT NULL, "removedBy" TEXT, "removalGeneration" INTEGER, "declineReason" TEXT, "failureReason" TEXT, "declaredBytes" INTEGER, "sourceBytes" INTEGER, "requestedAt" DATETIME NOT NULL, "updatedAt" DATETIME NOT NULL, "failedAt" DATETIME, PRIMARY KEY ("accountId", "itemId", "episodeId"), CHECK (revision >= 1), CHECK (state IN ('wanted', 'waitingForWatch', 'sending', 'delivered', 'removed', 'declined', 'failed')), CHECK (removedBy IS NULL OR removedBy IN ('phone', 'watch')), CHECK ((state = 'removed') = (removedBy IS NOT NULL)), CHECK (removalGeneration IS NULL OR removedBy = 'phone'), CHECK (declineReason IS NULL OR declineReason IN ('storageFull', 'invalid', 'signedOut')), CHECK ((state = 'declined') = (declineReason IS NOT NULL)), CHECK (failureReason IS NULL OR failureReason IN ('httpStatus', 'insecureRedirect', 'tooLarge', 'invalidResponse', 'network', 'itemMissing', 'noAudio', 'planInvalid')), CHECK (failureReason IS NULL OR state = 'failed'))
table	account	CREATE TABLE "account" ("id" INTEGER PRIMARY KEY AUTOINCREMENT, "clientUUID" TEXT NOT NULL UNIQUE, "serverBaseURL" TEXT NOT NULL, "serverUserId" TEXT NOT NULL, "serverVersion" TEXT NOT NULL, "defaultLibraryId" TEXT, "librarySelectionMode" TEXT NOT NULL DEFAULT 'all', "credentialNamespace" TEXT NOT NULL DEFAULT '', "signsInWithOpenID" BOOLEAN NOT NULL DEFAULT 0)
table	accountEndpoint	CREATE TABLE "accountEndpoint" ("id" INTEGER PRIMARY KEY AUTOINCREMENT, "accountId" INTEGER NOT NULL REFERENCES "account"("id") ON DELETE CASCADE, "normalizedURL" TEXT NOT NULL, "isPreferred" BOOLEAN NOT NULL DEFAULT 0, "sortOrder" INTEGER NOT NULL, "addedAt" DATETIME NOT NULL, "lastReachedAt" DATETIME, "lastFailedAt" DATETIME)
table	accountRemovalJournal	CREATE TABLE "accountRemovalJournal" ("id" INTEGER PRIMARY KEY AUTOINCREMENT, "serverBaseURL" TEXT NOT NULL, "serverUserId" TEXT NOT NULL, "accountRowId" INTEGER NOT NULL, "downloadsRootRelativePath" TEXT NOT NULL, "createdAt" DATETIME NOT NULL, "credentialNamespace" TEXT, "endpointURLs" TEXT)
table	adSignatureCreative	CREATE TABLE "adSignatureCreative" ("id" INTEGER PRIMARY KEY AUTOINCREMENT, "kind" TEXT NOT NULL CHECK ("kind" IN ('learned', 'tombstone')), "lastSeen" DATETIME NOT NULL, "startTime" DOUBLE NOT NULL, "endTime" DOUBLE NOT NULL, "audioPrint" BLOB, "confirmed" BOOLEAN NOT NULL DEFAULT 0)
table	adSignatureShingle	CREATE TABLE "adSignatureShingle" ("creativeId" INTEGER NOT NULL REFERENCES "adSignatureCreative"("id") ON DELETE CASCADE, "hash" INTEGER NOT NULL, PRIMARY KEY ("creativeId", "hash")) WITHOUT ROWID
table	adSignatureTeacher	CREATE TABLE "adSignatureTeacher" ("creativeId" INTEGER NOT NULL REFERENCES "adSignatureCreative"("id") ON DELETE CASCADE, "episodeKey" TEXT NOT NULL, PRIMARY KEY ("creativeId", "episodeKey")) WITHOUT ROWID
table	adSkipConfirmedSuppression	CREATE TABLE "adSkipConfirmedSuppression" ("episodeId" INTEGER NOT NULL REFERENCES "adSkipEpisode"("id") ON DELETE CASCADE, "creativeId" INTEGER NOT NULL REFERENCES "adSignatureCreative"("id") ON DELETE CASCADE, "createdAt" DATETIME NOT NULL, PRIMARY KEY ("episodeId", "creativeId"))
table	adSkipEpisode	CREATE TABLE "adSkipEpisode" ("id" INTEGER PRIMARY KEY AUTOINCREMENT, "source" TEXT NOT NULL CHECK ("source" IN ('abs', 'rss')), "accountId" INTEGER, "itemID" TEXT NOT NULL, "episodeID" TEXT NOT NULL, "fileByteSize" INTEGER NOT NULL, "fileModificationTime" DOUBLE NOT NULL, "transcriberRevision" TEXT NOT NULL, "rulesRevision" INTEGER NOT NULL, "state" TEXT NOT NULL, "transcriptFileName" TEXT UNIQUE, "analysedAt" DATETIME NOT NULL, "audioPrintFileName" TEXT, CHECK ((source = 'abs') = (accountId IS NOT NULL)))
table	adSkipListenerMark	CREATE TABLE "adSkipListenerMark" ("id" INTEGER PRIMARY KEY AUTOINCREMENT, "episodeId" INTEGER NOT NULL REFERENCES "adSkipEpisode"("id") ON DELETE CASCADE, "startTime" DOUBLE NOT NULL, "endTime" DOUBLE NOT NULL, "creativeId" INTEGER REFERENCES "adSignatureCreative"("id") ON DELETE SET NULL, "createdAt" DATETIME NOT NULL, "teachingRevision" INTEGER NOT NULL DEFAULT 1)
table	adSkipRange	CREATE TABLE "adSkipRange" ("id" INTEGER PRIMARY KEY AUTOINCREMENT, "episodeId" INTEGER NOT NULL REFERENCES "adSkipEpisode"("id") ON DELETE CASCADE, "startTime" DOUBLE NOT NULL, "endTime" DOUBLE NOT NULL, "meanAdProbability" DOUBLE NOT NULL, "rulesRevision" INTEGER NOT NULL, "fromStore" BOOLEAN NOT NULL, "endsItem" BOOLEAN NOT NULL, "creativeId" INTEGER REFERENCES "adSignatureCreative"("id") ON DELETE SET NULL, "fromTail" BOOLEAN NOT NULL DEFAULT 0, "fromHostRead" BOOLEAN NOT NULL DEFAULT 0, "fromListener" BOOLEAN NOT NULL DEFAULT 0)
table	adSkipStageOnePlan	CREATE TABLE "adSkipStageOnePlan" ("episodeId" INTEGER NOT NULL UNIQUE REFERENCES "adSkipEpisode"("id") ON DELETE CASCADE, "libraryKey" TEXT NOT NULL, "windows" BLOB NOT NULL, "audioEdges" BLOB NOT NULL DEFAULT X'', "crossShowAlignments" BLOB NOT NULL DEFAULT X'', "sameShowEdges" BLOB NOT NULL DEFAULT X'')
table	audioBookmark	CREATE TABLE "audioBookmark" ("accountId" INTEGER NOT NULL REFERENCES "account"("id") ON DELETE CASCADE, "serverItemId" TEXT NOT NULL, "time" DOUBLE NOT NULL, "title" TEXT NOT NULL, "createdAt" DATETIME, PRIMARY KEY ("accountId", "serverItemId", "time"))
table	coverPaletteRecord	CREATE TABLE "coverPaletteRecord" ("itemId" TEXT PRIMARY KEY, "artworkKey" TEXT NOT NULL, "accentHue" DOUBLE, "accentSaturation" DOUBLE, "accentBrightness" DOUBLE, "extractedAt" DATETIME NOT NULL, "clusterWeight" DOUBLE, "clusterRed" DOUBLE, "clusterGreen" DOUBLE, "clusterBlue" DOUBLE, "averageRed" DOUBLE, "averageGreen" DOUBLE, "averageBlue" DOUBLE)
table	coverShape	CREATE TABLE "coverShape" ("itemId" TEXT PRIMARY KEY NOT NULL, "revision" TEXT NOT NULL, "aspectRatio" DOUBLE NOT NULL, "fitPixelWidth" INTEGER NOT NULL, "measuredAt" DATETIME NOT NULL)
table	diagnosticsEvent	CREATE TABLE "diagnosticsEvent" ("id" INTEGER PRIMARY KEY AUTOINCREMENT, "accountId" INTEGER NOT NULL REFERENCES "account"("id") ON DELETE CASCADE, "category" TEXT NOT NULL, "statusClass" TEXT NOT NULL, "durationMilliseconds" DOUBLE NOT NULL, "endpointTemplate" TEXT, "occurredAt" DATETIME NOT NULL)
table	download	CREATE TABLE "download" ("id" INTEGER PRIMARY KEY AUTOINCREMENT, "accountId" INTEGER NOT NULL REFERENCES "account"("id") ON DELETE CASCADE, "itemId" INTEGER NOT NULL REFERENCES "item"("id") ON DELETE CASCADE, "podcastEpisodeId" INTEGER REFERENCES "podcastEpisode"("id") ON DELETE CASCADE, "serverFileIno" TEXT NOT NULL, "orderIndex" INTEGER NOT NULL, "destinationRelativePath" TEXT NOT NULL, "expectedBytes" INTEGER NOT NULL, "expectedMimeType" TEXT NOT NULL, "fileDurationSeconds" DOUBLE NOT NULL, "receivedBytes" INTEGER NOT NULL DEFAULT 0, "resumeData" BLOB, "state" TEXT NOT NULL, "holdReason" TEXT, "errorCategory" TEXT, "origin" TEXT NOT NULL DEFAULT 'manual', "mediaKind" TEXT NOT NULL DEFAULT 'audio', "autoRetryCount" INTEGER NOT NULL DEFAULT 0, "autoRetryNotBefore" DATETIME)
table	ebookTOCEntry	CREATE TABLE "ebookTOCEntry" ("id" INTEGER PRIMARY KEY AUTOINCREMENT, "accountId" INTEGER NOT NULL, "itemId" INTEGER NOT NULL, "position" INTEGER NOT NULL, "title" TEXT NOT NULL, "href" TEXT, "depth" INTEGER NOT NULL, "startProgression" DOUBLE, FOREIGN KEY ("accountId", "itemId") REFERENCES "item"("accountId", "id") ON DELETE CASCADE)
table	episodeSearch	CREATE VIRTUAL TABLE episodeSearch USING fts5( title, subtitle, episodeDescription, content='podcastEpisode', content_rowid='id' )
table	episodeSearch_config	CREATE TABLE 'episodeSearch_config'(k PRIMARY KEY, v) WITHOUT ROWID
table	episodeSearch_data	CREATE TABLE 'episodeSearch_data'(id INTEGER PRIMARY KEY, block BLOB)
table	episodeSearch_docsize	CREATE TABLE 'episodeSearch_docsize'(id INTEGER PRIMARY KEY, sz BLOB)
table	episodeSearch_idx	CREATE TABLE 'episodeSearch_idx'(segid, term, pgno, PRIMARY KEY(segid, term)) WITHOUT ROWID
table	episodeTranscript	CREATE TABLE "episodeTranscript" ("id" INTEGER PRIMARY KEY AUTOINCREMENT, "source" TEXT NOT NULL CHECK ("source" IN ('abs', 'rss')), "accountId" INTEGER, "itemID" TEXT NOT NULL, "episodeID" TEXT NOT NULL, "fileByteSize" INTEGER NOT NULL, "fileModificationTime" DOUBLE NOT NULL, "transcriberRevision" TEXT NOT NULL, "state" TEXT NOT NULL, "transcriptFileName" TEXT UNIQUE, "updatedAt" DATETIME NOT NULL, CHECK ((source = 'abs') = (accountId IS NOT NULL)))
table	hiddenContinueSeries	CREATE TABLE "hiddenContinueSeries" ("accountId" INTEGER NOT NULL REFERENCES "account"("id") ON DELETE CASCADE, "serverSeriesId" TEXT NOT NULL, PRIMARY KEY ("accountId", "serverSeriesId"))
table	item	CREATE TABLE "item" ("id" INTEGER PRIMARY KEY AUTOINCREMENT, "accountId" INTEGER NOT NULL REFERENCES "account"("id") ON DELETE CASCADE, "libraryId" INTEGER NOT NULL REFERENCES "library"("id") ON DELETE CASCADE, "serverItemId" TEXT NOT NULL, "mediaKind" TEXT NOT NULL, "title" TEXT NOT NULL, "sortTitle" TEXT NOT NULL, "author" TEXT, "durationSeconds" DOUBLE, "addedAt" DATETIME, "numAudioFiles" INTEGER, "ebookFormat" TEXT, "softDeleted" BOOLEAN NOT NULL DEFAULT 0, "podcastAutoDownloadEpisodes" BOOLEAN, "podcastLastEpisodeCheck" DATETIME, "serverUpdatedAt" DATETIME, "podcastServerEpisodeCount" INTEGER, "seriesName" TEXT, "narratorName" TEXT, "expandedMetadataFetchedAt" DATETIME, "itemDescription" TEXT, "ebookFileIno" TEXT, "ebookFileExt" TEXT, "podcastAutoDownloadSchedule" TEXT, "podcastMaxEpisodesToKeep" INTEGER, "podcastMaxNewEpisodesToDownload" INTEGER, "hasServerArtwork" BOOLEAN, "audioDownloadExpectedBytes" INTEGER, "ebookDownloadExpectedBytes" INTEGER, "podcastFeedFingerprint" TEXT, "podcastLanguage" TEXT)
table	itemChapter	CREATE TABLE "itemChapter" ("id" INTEGER PRIMARY KEY AUTOINCREMENT, "accountId" INTEGER NOT NULL, "itemId" INTEGER NOT NULL, "position" INTEGER NOT NULL, "serverChapterId" INTEGER NOT NULL, "start" DOUBLE NOT NULL, "end" DOUBLE NOT NULL, "title" TEXT, FOREIGN KEY ("accountId", "itemId") REFERENCES "item"("accountId", "id") ON DELETE CASCADE)
table	itemPlaybackSettings	CREATE TABLE "itemPlaybackSettings" ("itemId" INTEGER PRIMARY KEY, "accountId" INTEGER NOT NULL REFERENCES "account"("id") ON DELETE CASCADE, "rateStep" INTEGER NOT NULL, FOREIGN KEY ("accountId", "itemId") REFERENCES "item"("accountId", "id") ON DELETE CASCADE)
table	itemQuarantine	CREATE TABLE "itemQuarantine" ("itemId" INTEGER PRIMARY KEY, "accountId" INTEGER NOT NULL REFERENCES "account"("id") ON DELETE CASCADE, "serverItemId" TEXT NOT NULL, "reason" TEXT NOT NULL CHECK ("reason" = 'reservedPodcastSourceIdentity'), "quarantinedAt" DATETIME NOT NULL, "terminalizedOperationCount" INTEGER NOT NULL CHECK ("terminalizedOperationCount" >= 0))
table	itemSearch	CREATE VIRTUAL TABLE itemSearch USING fts5( title, author, seriesName, narratorName, content='item', content_rowid='id' )
table	itemSearch_config	CREATE TABLE 'itemSearch_config'(k PRIMARY KEY, v) WITHOUT ROWID
table	itemSearch_data	CREATE TABLE 'itemSearch_data'(id INTEGER PRIMARY KEY, block BLOB)
table	itemSearch_docsize	CREATE TABLE 'itemSearch_docsize'(id INTEGER PRIMARY KEY, sz BLOB)
table	itemSearch_idx	CREATE TABLE 'itemSearch_idx'(segid, term, pgno, PRIMARY KEY(segid, term)) WITHOUT ROWID
table	itemSeen	CREATE TABLE "itemSeen" ("itemId" INTEGER PRIMARY KEY REFERENCES "item"("id") ON DELETE CASCADE, "generation" INTEGER NOT NULL)
table	itemSupplement	CREATE TABLE "itemSupplement" ("id" INTEGER PRIMARY KEY AUTOINCREMENT, "accountId" INTEGER NOT NULL REFERENCES "account"("id") ON DELETE CASCADE, "itemId" INTEGER NOT NULL, "position" INTEGER NOT NULL, "serverFileIno" TEXT NOT NULL, "filename" TEXT, "sizeBytes" INTEGER NOT NULL, "lastViewedPage" INTEGER, FOREIGN KEY ("accountId", "itemId") REFERENCES "item"("accountId", "id") ON DELETE CASCADE)
table	library	CREATE TABLE "library" ("id" INTEGER PRIMARY KEY AUTOINCREMENT, "accountId" INTEGER NOT NULL REFERENCES "account"("id") ON DELETE CASCADE, "serverLibraryId" TEXT NOT NULL, "mediaType" TEXT NOT NULL, "name" TEXT NOT NULL, "lastSeenGeneration" INTEGER NOT NULL DEFAULT 0, "softDeleted" BOOLEAN NOT NULL DEFAULT 0, "isIncluded" BOOLEAN NOT NULL DEFAULT 1, "onlyShowLaterBooksInContinueSeries" BOOLEAN NOT NULL DEFAULT 0)
table	libraryCollection	CREATE TABLE "libraryCollection" ("id" INTEGER PRIMARY KEY AUTOINCREMENT, "libraryId" INTEGER NOT NULL REFERENCES "library"("id") ON DELETE CASCADE, "kind" TEXT NOT NULL, "serverId" TEXT NOT NULL, "name" TEXT, "description" TEXT, "lastUpdate" DATETIME, UNIQUE ("libraryId", "kind", "serverId"))
table	libraryCollectionMember	CREATE TABLE "libraryCollectionMember" ("collectionId" INTEGER NOT NULL REFERENCES "libraryCollection"("id") ON DELETE CASCADE, "position" INTEGER NOT NULL, "serverItemId" TEXT NOT NULL, "serverEpisodeId" TEXT, "fallbackTitle" TEXT, PRIMARY KEY ("collectionId", "position"))
table	libraryCollectionSnapshot	CREATE TABLE "libraryCollectionSnapshot" ("libraryId" INTEGER NOT NULL REFERENCES "library"("id") ON DELETE CASCADE, "kind" TEXT NOT NULL, "fetchedAt" DATETIME NOT NULL, PRIMARY KEY ("libraryId", "kind"))
table	libraryEntityIndex	CREATE TABLE "libraryEntityIndex" ("id" INTEGER PRIMARY KEY AUTOINCREMENT, "libraryId" INTEGER NOT NULL REFERENCES "library"("id") ON DELETE CASCADE, "kind" TEXT NOT NULL, "serverEntityId" TEXT NOT NULL, "name" TEXT NOT NULL, "normalizedName" TEXT NOT NULL, "bookCount" INTEGER)
table	libraryFilterDataSnapshot	CREATE TABLE "libraryFilterDataSnapshot" ("libraryId" INTEGER PRIMARY KEY REFERENCES "library"("id") ON DELETE CASCADE, "fetchedAt" DATETIME NOT NULL)
table	listeningHistoryEntry	CREATE TABLE "listeningHistoryEntry" ("id" INTEGER PRIMARY KEY AUTOINCREMENT, "accountId" INTEGER NOT NULL REFERENCES "account"("id") ON DELETE CASCADE, "itemId" INTEGER NOT NULL REFERENCES "item"("id") ON DELETE CASCADE, "sessionId" TEXT NOT NULL, "startedAt" DATETIME NOT NULL, "startPosition" DOUBLE NOT NULL, "endPosition" DOUBLE NOT NULL, "listenedSeconds" DOUBLE NOT NULL)
table	listeningQueueEntry	CREATE TABLE "listeningQueueEntry" ("id" INTEGER PRIMARY KEY AUTOINCREMENT, "accountId" INTEGER NOT NULL REFERENCES "account"("id") ON DELETE CASCADE, "itemId" INTEGER NOT NULL, "podcastEpisodeId" INTEGER, "position" INTEGER NOT NULL, "chapterStart" DOUBLE, "chapterEnd" DOUBLE, "chapterTitle" TEXT, "downloadDeclinedAt" DATETIME, FOREIGN KEY ("accountId", "itemId") REFERENCES "item"("accountId", "id") ON DELETE CASCADE, FOREIGN KEY ("accountId", "podcastEpisodeId") REFERENCES "podcastEpisode"("accountId", "id") ON DELETE CASCADE)
table	listeningQueueRevision	CREATE TABLE "listeningQueueRevision" ("accountId" INTEGER PRIMARY KEY REFERENCES "account"("id") ON DELETE CASCADE, "revision" INTEGER NOT NULL DEFAULT 0)
table	listeningStatsSnapshot	CREATE TABLE "listeningStatsSnapshot" ("accountId" INTEGER PRIMARY KEY REFERENCES "account"("id") ON DELETE CASCADE, "fetchedAt" DATETIME NOT NULL, "totalSeconds" DOUBLE NOT NULL, "daysJSON" TEXT NOT NULL, "weekdaysJSON" TEXT NOT NULL, "titlesJSON" TEXT NOT NULL)
table	mediaProgress	CREATE TABLE "mediaProgress" ("id" INTEGER PRIMARY KEY AUTOINCREMENT, "accountId" INTEGER NOT NULL REFERENCES "account"("id") ON DELETE CASCADE, "itemId" INTEGER NOT NULL REFERENCES "item"("id") ON DELETE CASCADE, "podcastEpisodeId" INTEGER REFERENCES "podcastEpisode"("id") ON DELETE CASCADE, "currentTime" DOUBLE NOT NULL, "isFinished" BOOLEAN NOT NULL, "serverUpdatedAt" DATETIME, "localSequence" INTEGER NOT NULL, "origin" TEXT NOT NULL, "originKey" TEXT NOT NULL, "readingPositionJSON" TEXT, "ebookProgress" DOUBLE, "ebookLocation" TEXT, "lastActivityAt" DATETIME, "hideFromContinueListening" BOOLEAN NOT NULL DEFAULT 0, "serverProgressId" TEXT, "serverProgressUpdatedAt" DATETIME)
table	nativeEpisodeServerSaveAttempt	CREATE TABLE "nativeEpisodeServerSaveAttempt" ("id" INTEGER PRIMARY KEY AUTOINCREMENT, "accountId" INTEGER NOT NULL REFERENCES "account"("id") ON DELETE CASCADE, "accountClientUUID" TEXT NOT NULL, "accountServerIdentityFingerprint" TEXT NOT NULL, "feedId" INTEGER NOT NULL, "episodeId" INTEGER NOT NULL, "episodeIdentityKey" TEXT NOT NULL, "serverItemId" TEXT, "serverEpisodeId" TEXT, "preflightPresence" TEXT, "state" TEXT NOT NULL, "errorCategory" TEXT, "createdAt" DATETIME NOT NULL, "updatedAt" DATETIME NOT NULL, CHECK (feedId > 0 AND episodeId > 0), CHECK (length(CAST(accountClientUUID AS BLOB)) BETWEEN 1 AND 512), CHECK (length(accountServerIdentityFingerprint) = 64 AND accountServerIdentityFingerprint NOT GLOB '*[^0-9a-f]*'), CHECK (length(CAST(episodeIdentityKey AS BLOB)) BETWEEN 1 AND 512), CHECK (serverItemId IS NULL OR length(CAST(serverItemId AS BLOB)) BETWEEN 1 AND 512), CHECK (serverEpisodeId IS NULL OR length(CAST(serverEpisodeId AS BLOB)) BETWEEN 1 AND 512), CHECK (preflightPresence IS NULL OR preflightPresence IN ('preExisting', 'absentBeforeRequest')), CHECK (state IN ( 'preparing', 'creatingShow', 'createUncertain', 'requestingDownload', 'accepted', 'confirmed', 'deleting', 'removed', 'deleteUncertain', 'deleteFailed', 'uncertain', 'failed' )), CHECK (errorCategory IS NULL OR errorCategory IN ( 'invalidDestination', 'permissionChanged', 'staleIdentity', 'transport', 'serverFailure', 'malformedResponse', 'cancelled', 'credentialedFeed', 'unsubscribed', 'missingEpisode', 'incompleteEpisodeList', 'localPersistence', 'accountReplaced', 'unknown' )))
table	nativeListeningQueueRevision	CREATE TABLE nativeListeningQueueRevision ( id INTEGER PRIMARY KEY CHECK (id = 1), revision INTEGER NOT NULL DEFAULT 0 )
table	nativePodcastSettings	CREATE TABLE "nativePodcastSettings" ("id" INTEGER PRIMARY KEY CHECK ("id" = 1), "autoDownloadEnabled" BOOLEAN NOT NULL DEFAULT 0, "keepLatestCount" INTEGER NOT NULL CHECK ("keepLatestCount" >= 0) DEFAULT 3, "deleteAfterPlayed" BOOLEAN NOT NULL DEFAULT 0, "allowCellularAutoDownload" BOOLEAN NOT NULL DEFAULT 0, "enabledAt" DATETIME)
table	observedServerTime	CREATE TABLE "observedServerTime" ("id" INTEGER PRIMARY KEY AUTOINCREMENT, "accountId" INTEGER NOT NULL REFERENCES "account"("id") ON DELETE CASCADE, "offsetSeconds" DOUBLE NOT NULL, "observedAt" DATETIME NOT NULL)
table	outboxOperation	CREATE TABLE "outboxOperation" ("id" INTEGER PRIMARY KEY AUTOINCREMENT, "accountId" INTEGER NOT NULL REFERENCES "account"("id") ON DELETE CASCADE, "clientOperationId" TEXT NOT NULL UNIQUE, "entityKey" TEXT NOT NULL, "operationKind" TEXT NOT NULL, "coalescingKey" TEXT NOT NULL, "payloadVersion" INTEGER NOT NULL, "localSequence" INTEGER NOT NULL, "attempts" INTEGER NOT NULL DEFAULT 0, "nextAttemptAt" DATETIME, "state" TEXT NOT NULL, "payloadCurrentTime" DOUBLE, "payloadIsFinished" BOOLEAN, "payloadAccumulatedDeltaSeconds" DOUBLE, "payloadDurationSeconds" DOUBLE, "playbackSessionId" INTEGER REFERENCES "playbackSession"("id") ON DELETE CASCADE, "deadLetterReason" TEXT, "podcastEpisodeId" INTEGER REFERENCES "podcastEpisode"("id") ON DELETE CASCADE, "payloadEbookProgress" DOUBLE, "payloadEbookLocation" TEXT, "payloadHideFromContinueListening" BOOLEAN, "payloadResetMedium" TEXT, "payloadResetPhase" TEXT, "payloadRestoreProgress" DOUBLE, "payloadBookmarkTime" DOUBLE, "payloadBookmarkTitle" TEXT)
table	pauseTrimEpisode	CREATE TABLE "pauseTrimEpisode" ("id" INTEGER PRIMARY KEY AUTOINCREMENT, "source" TEXT NOT NULL CHECK ("source" IN ('abs', 'rss')), "accountId" INTEGER, "itemID" TEXT NOT NULL, "episodeID" TEXT NOT NULL, "fileByteSize" INTEGER NOT NULL, "fileModificationTime" DOUBLE NOT NULL, "detectorRevision" INTEGER NOT NULL, "state" TEXT NOT NULL, "runs" BLOB, "analysedAt" DATETIME NOT NULL, CHECK ((source = 'abs') = (accountId IS NOT NULL)))
table	pinnedList	CREATE TABLE "pinnedList" ("accountId" INTEGER NOT NULL REFERENCES "account"("id") ON DELETE CASCADE, "serverLibraryId" TEXT NOT NULL, "kind" TEXT NOT NULL, "serverId" TEXT NOT NULL, "pinnedAt" DATETIME NOT NULL, PRIMARY KEY ("accountId", "serverLibraryId", "kind", "serverId"))
table	pinnedListClaim	CREATE TABLE "pinnedListClaim" ("accountId" INTEGER NOT NULL REFERENCES "account"("id") ON DELETE CASCADE, "serverLibraryId" TEXT NOT NULL, "kind" TEXT NOT NULL, "serverId" TEXT NOT NULL, "serverItemId" TEXT NOT NULL, "serverEpisodeId" TEXT NOT NULL, "recordedAt" DATETIME NOT NULL, PRIMARY KEY ("accountId", "serverLibraryId", "kind", "serverId", "serverItemId", "serverEpisodeId"), FOREIGN KEY ("accountId", "serverLibraryId", "kind", "serverId") REFERENCES "pinnedList"("accountId", "serverLibraryId", "kind", "serverId") ON DELETE CASCADE)
table	pinnedListDecline	CREATE TABLE "pinnedListDecline" ("accountId" INTEGER NOT NULL REFERENCES "account"("id") ON DELETE CASCADE, "serverLibraryId" TEXT NOT NULL, "kind" TEXT NOT NULL, "serverId" TEXT NOT NULL, "serverItemId" TEXT NOT NULL, "serverEpisodeId" TEXT NOT NULL, "recordedAt" DATETIME NOT NULL, PRIMARY KEY ("accountId", "serverLibraryId", "kind", "serverId", "serverItemId", "serverEpisodeId"), FOREIGN KEY ("accountId", "serverLibraryId", "kind", "serverId") REFERENCES "pinnedList"("accountId", "serverLibraryId", "kind", "serverId") ON DELETE CASCADE)
table	playbackBookmark	CREATE TABLE "playbackBookmark" ("id" INTEGER PRIMARY KEY AUTOINCREMENT, "accountId" INTEGER NOT NULL REFERENCES "account"("id") ON DELETE CASCADE, "itemId" INTEGER NOT NULL REFERENCES "item"("id") ON DELETE CASCADE, "podcastEpisodeId" INTEGER REFERENCES "podcastEpisode"("id") ON DELETE CASCADE, "updatedAt" DATETIME NOT NULL)
table	playbackSession	CREATE TABLE "playbackSession" ("id" INTEGER PRIMARY KEY AUTOINCREMENT, "accountId" INTEGER NOT NULL REFERENCES "account"("id") ON DELETE CASCADE, "clientSessionId" TEXT NOT NULL UNIQUE, "serverSessionId" TEXT, "itemId" INTEGER NOT NULL REFERENCES "item"("id") ON DELETE CASCADE, "podcastEpisodeId" INTEGER REFERENCES "podcastEpisode"("id") ON DELETE CASCADE, "startedAt" DATETIME NOT NULL, "updatedAt" DATETIME NOT NULL, "listenedDeltaSeconds" DOUBLE NOT NULL DEFAULT 0, "closePending" BOOLEAN NOT NULL DEFAULT 0, "isOffline" BOOLEAN NOT NULL DEFAULT 0, "globalPosition" DOUBLE NOT NULL DEFAULT 0, "duration" DOUBLE, "state" TEXT NOT NULL DEFAULT 'active', "lastLocalSequence" INTEGER NOT NULL DEFAULT 0, "startPosition" DOUBLE, "acknowledgedListenedSeconds" DOUBLE NOT NULL DEFAULT 0)
table	podcastCloudDirty	CREATE TABLE podcastCloudDirty ( kind TEXT NOT NULL, key TEXT NOT NULL, PRIMARY KEY (kind, key) ) WITHOUT ROWID
table	podcastCloudEntityStamp	CREATE TABLE podcastCloudEntityStamp ( recordName TEXT PRIMARY KEY NOT NULL, physicalMilliseconds INTEGER NOT NULL CHECK (physicalMilliseconds >= 0), logicalCounter INTEGER NOT NULL CHECK (logicalCounter >= 0), installationUUID TEXT NOT NULL, mutationUUID TEXT NOT NULL , payload BLOB)
table	podcastCloudHeldRecord	CREATE TABLE podcastCloudHeldRecord ( namespace BLOB NOT NULL, recordName TEXT NOT NULL, generation INTEGER, category TEXT NOT NULL, observedAt DATETIME NOT NULL, PRIMARY KEY (namespace, recordName) )
table	podcastCloudInstallation	CREATE TABLE podcastCloudInstallation ( id INTEGER PRIMARY KEY CHECK (id = 1), installationUUID TEXT NOT NULL CHECK (length(installationUUID) = 36), physicalMilliseconds INTEGER NOT NULL DEFAULT 0 CHECK (physicalMilliseconds >= 0), logicalCounter INTEGER NOT NULL DEFAULT 0 CHECK (logicalCounter >= 0), anchorServerMilliseconds INTEGER CHECK (anchorServerMilliseconds IS NULL OR anchorServerMilliseconds >= 0), lastAdmittedPhysicalMilliseconds INTEGER NOT NULL DEFAULT 0 CHECK (lastAdmittedPhysicalMilliseconds >= 0), lastAdmittedLogicalCounter INTEGER NOT NULL DEFAULT 0 CHECK (lastAdmittedLogicalCounter >= 0), repairRequired INTEGER NOT NULL DEFAULT 0 CHECK (repairRequired IN (0, 1)), -- `PodcastCloudClockState`'s cross-field guard, restated because `Persistence` cannot -- import `SyncEngine`: a clock may never sit behind the last stamp it admitted. CHECK ( physicalMilliseconds > lastAdmittedPhysicalMilliseconds OR (physicalMilliseconds = lastAdmittedPhysicalMilliseconds AND logicalCounter >= lastAdmittedLogicalCounter) ) )
table	podcastCloudOutbox	CREATE TABLE podcastCloudOutbox ( recordName TEXT PRIMARY KEY NOT NULL, generation INTEGER NOT NULL CHECK (generation > 0), namespace BLOB, operation TEXT NOT NULL CHECK (operation IN ('save', 'delete')), payload BLOB NOT NULL CHECK (length(payload) <= 65536) )
table	podcastCloudRepublishDebt	CREATE TABLE podcastCloudRepublishDebt ( recordKind TEXT NOT NULL CHECK (recordKind IN ('saved')), subscriptionUUID TEXT NOT NULL, identityKey TEXT NOT NULL, alternateIdentityKey TEXT, guid TEXT, enclosureURL TEXT, recordedAt DATETIME NOT NULL, PRIMARY KEY (recordKind, subscriptionUUID, identityKey) )
table	podcastCloudSubscriptionRegistry	CREATE TABLE podcastCloudSubscriptionRegistry ( subscriptionUUID TEXT PRIMARY KEY NOT NULL, fingerprint TEXT NOT NULL, normalizedURL TEXT NOT NULL, canonicalizationVersion INTEGER NOT NULL, generationUUID TEXT NOT NULL, isFollowed INTEGER NOT NULL CHECK (isFollowed IN (0, 1)), followPhysicalMilliseconds INTEGER NOT NULL, followLogicalCounter INTEGER NOT NULL, followInstallationUUID TEXT NOT NULL, followMutationUUID TEXT NOT NULL )
table	podcastCloudSystemFields	CREATE TABLE podcastCloudSystemFields ( namespace BLOB NOT NULL, recordName TEXT NOT NULL, generation INTEGER NOT NULL CHECK (generation > 0), archive BLOB NOT NULL, PRIMARY KEY (namespace, recordName) )
table	podcastCloudTransport	CREATE TABLE podcastCloudTransport ( id INTEGER PRIMARY KEY CHECK (id = 1), namespace BLOB, nextGeneration INTEGER NOT NULL DEFAULT 0 CHECK (nextGeneration >= 0), bootstrapComplete INTEGER NOT NULL DEFAULT 0 CHECK (bootstrapComplete IN (0, 1)), engineState BLOB , zoneEstablished INTEGER NOT NULL DEFAULT 0 CHECK (zoneEstablished IN (0, 1)), status TEXT, statusRetryAfter DATETIME)
table	podcastCloudUnresolvedEpisodeState	CREATE TABLE podcastCloudUnresolvedEpisodeState ( recordName TEXT PRIMARY KEY NOT NULL, subscriptionUUID TEXT NOT NULL, generationUUID TEXT NOT NULL, episodeDigest TEXT NOT NULL, payload BLOB NOT NULL CHECK (length(payload) <= 65536), receivedAt DATETIME NOT NULL )
table	podcastEpisode	CREATE TABLE "podcastEpisode" ("id" INTEGER PRIMARY KEY AUTOINCREMENT, "accountId" INTEGER NOT NULL REFERENCES "account"("id") ON DELETE CASCADE, "itemId" INTEGER NOT NULL REFERENCES "item"("id") ON DELETE CASCADE, "serverEpisodeId" TEXT NOT NULL, "title" TEXT NOT NULL, "episodeNumber" TEXT, "lastSeenGeneration" INTEGER NOT NULL, "softDeleted" BOOLEAN NOT NULL DEFAULT 0, "subtitle" TEXT, "episodeDescription" TEXT, "seasonNumber" TEXT, "episodeType" TEXT, "mimeType" TEXT, "durationSeconds" DOUBLE, "sizeBytes" INTEGER, "publishedAt" DATETIME, "storedAudioIno" TEXT, "storedAudioExpectedSize" INTEGER, "storedAudioMimeType" TEXT, "storedAudioDurationSeconds" DOUBLE, "autoDownloadDecidedAt" DATETIME)
table	podcastEpisodeChapter	CREATE TABLE "podcastEpisodeChapter" ("id" INTEGER PRIMARY KEY AUTOINCREMENT, "accountId" INTEGER NOT NULL REFERENCES "account"("id") ON DELETE CASCADE, "podcastEpisodeId" INTEGER NOT NULL REFERENCES "podcastEpisode"("id") ON DELETE CASCADE, "position" INTEGER NOT NULL, "serverChapterId" INTEGER NOT NULL, "start" DOUBLE NOT NULL, "end" DOUBLE NOT NULL, "title" TEXT)
table	podcastRefreshState	CREATE TABLE "podcastRefreshState" ("itemId" INTEGER PRIMARY KEY REFERENCES "item"("id") ON DELETE CASCADE, "lastAttemptAt" DATETIME, "lastSuccessfulRefreshAt" DATETIME, "consecutiveFailures" INTEGER NOT NULL DEFAULT 0, "nextEligibleAttemptAt" DATETIME, "lastCompleteEpisodeListAt" DATETIME)
table	podcastSettings	CREATE TABLE "podcastSettings" ("accountId" INTEGER PRIMARY KEY REFERENCES "account"("id") ON DELETE CASCADE, "autoDownloadEnabled" BOOLEAN NOT NULL DEFAULT 0, "keepLatestCount" INTEGER NOT NULL DEFAULT 3, "deleteAfterPlayed" BOOLEAN NOT NULL DEFAULT 0, "allowCellularAutoDownload" BOOLEAN NOT NULL DEFAULT 0, "enabledAt" DATETIME)
table	podcastShowOrder	CREATE TABLE "podcastShowOrder" ("accountId" INTEGER PRIMARY KEY REFERENCES "account"("id") ON DELETE CASCADE, "mode" TEXT NOT NULL)
table	podcastShowOrderEntry	CREATE TABLE "podcastShowOrderEntry" ("id" INTEGER PRIMARY KEY AUTOINCREMENT, "accountId" INTEGER NOT NULL REFERENCES "account"("id") ON DELETE CASCADE, "itemId" INTEGER NOT NULL, "position" INTEGER NOT NULL, FOREIGN KEY ("accountId", "itemId") REFERENCES "item"("accountId", "id") ON DELETE CASCADE)
table	podcastShowSettings	CREATE TABLE "podcastShowSettings" ("itemId" INTEGER PRIMARY KEY REFERENCES "item"("id") ON DELETE CASCADE, "accountId" INTEGER NOT NULL REFERENCES "account"("id") ON DELETE CASCADE, "autoDownloadOverride" TEXT NOT NULL DEFAULT 'inherit', "keepLatestOverride" INTEGER, "deleteAfterPlayedOverride" BOOLEAN, "enabledAt" DATETIME, trimSilencesOverride TEXT NOT NULL DEFAULT 'inherit' CHECK (trimSilencesOverride IN ('inherit', 'off', 'moderate', 'maximum')), voiceBoostOverride TEXT NOT NULL DEFAULT 'inherit' CHECK (voiceBoostOverride IN ('inherit', 'on', 'off')))
table	progressConflict	CREATE TABLE "progressConflict" ("id" INTEGER PRIMARY KEY AUTOINCREMENT, "accountId" INTEGER NOT NULL REFERENCES "account"("id") ON DELETE CASCADE, "itemId" INTEGER NOT NULL REFERENCES "item"("id") ON DELETE CASCADE, "serverCurrentTime" DOUBLE NOT NULL, "serverIsFinished" BOOLEAN NOT NULL, "serverUpdatedAt" DATETIME, "detectedAt" DATETIME NOT NULL, "podcastEpisodeId" INTEGER REFERENCES "podcastEpisode"("id") ON DELETE CASCADE, "serverEbookProgress" DOUBLE, "serverEbookLocation" TEXT)
table	readerPreferences	CREATE TABLE "readerPreferences" ("accountId" INTEGER PRIMARY KEY REFERENCES "account"("id") ON DELETE CASCADE, "preferencesJSON" TEXT NOT NULL)
table	recentSearch	CREATE TABLE "recentSearch" ("id" INTEGER PRIMARY KEY AUTOINCREMENT, "accountId" INTEGER NOT NULL REFERENCES "account"("id") ON DELETE CASCADE, "normalizedQuery" TEXT NOT NULL, "displayQuery" TEXT NOT NULL, "lastUsedAt" DATETIME NOT NULL)
table	rssDownload	CREATE TABLE "rssDownload" ("id" INTEGER PRIMARY KEY AUTOINCREMENT, "episodeId" INTEGER NOT NULL UNIQUE REFERENCES "rssEpisode"("id") ON DELETE CASCADE, "state" TEXT NOT NULL, "relativePath" TEXT NOT NULL, "expectedBytes" INTEGER, "actualBytes" INTEGER NOT NULL DEFAULT 0, "origin" TEXT NOT NULL, "decidedStamp" DATETIME NOT NULL, "holdReason" TEXT, "errorCode" TEXT, "createdAt" DATETIME NOT NULL, "updatedAt" DATETIME NOT NULL, "chaptersExtractedAt" DATETIME, "autoRetryCount" INTEGER NOT NULL DEFAULT 0, "autoRetryNotBefore" DATETIME, "measuredDurationSeconds" DOUBLE, CHECK (state IN ('pending', 'downloading', 'paused', 'pausedAuth', 'interrupted', 'deleting', 'completed', 'failed')), CHECK (origin IN ('manual', 'automatic')))
table	rssEpisode	CREATE TABLE "rssEpisode" ("id" INTEGER PRIMARY KEY AUTOINCREMENT, "feedId" INTEGER NOT NULL REFERENCES "rssFeed"("id") ON DELETE CASCADE, "identityKey" TEXT NOT NULL, "alternateIdentityKey" TEXT, "guid" TEXT, "title" TEXT, "synopsis" TEXT, "enclosureURL" TEXT NOT NULL, "enclosureType" TEXT, "declaredBytes" INTEGER, "publishedAt" DATETIME, "durationSeconds" DOUBLE, "seasonNumber" INTEGER, "episodeNumber" INTEGER, "lastSeenGeneration" INTEGER NOT NULL, "retained" BOOLEAN NOT NULL DEFAULT 0, "measuredDurationSeconds" DOUBLE, "synopsisLine" TEXT, "autoDownloadDecidedAt" DATETIME, "artworkURL" TEXT)
table	rssEpisodeChapter	CREATE TABLE "rssEpisodeChapter" ("id" INTEGER PRIMARY KEY AUTOINCREMENT, "episodeId" INTEGER NOT NULL REFERENCES "rssEpisode"("id") ON DELETE CASCADE, "position" INTEGER NOT NULL, "start" DOUBLE NOT NULL, "end" DOUBLE NOT NULL, "title" TEXT)
table	rssEpisodeNotificationLedger	CREATE TABLE "rssEpisodeNotificationLedger" ("feedId" INTEGER NOT NULL REFERENCES "rssFeed"("id") ON DELETE CASCADE, "identityKey" TEXT NOT NULL, "disposition" TEXT NOT NULL, "firstSeenAt" DATETIME NOT NULL, "scheduledRequestID" TEXT, PRIMARY KEY ("feedId", "identityKey"), CHECK (disposition IN ( 'silentBaseline', 'pending', 'suppressedForeground', 'suppressedDisabled', 'suppressedIneligible', 'suppressedLifecycle', 'scheduled', 'alias' )))
table	rssEpisodeState	CREATE TABLE "rssEpisodeState" ("episodeId" INTEGER PRIMARY KEY REFERENCES "rssEpisode"("id") ON DELETE CASCADE, "position" DOUBLE NOT NULL, "finished" BOOLEAN NOT NULL DEFAULT 0, "localSequence" INTEGER NOT NULL, "updatedAt" DATETIME NOT NULL, "hideFromContinueListening" BOOLEAN NOT NULL DEFAULT 0)
table	rssFeed	CREATE TABLE "rssFeed" ("id" INTEGER PRIMARY KEY AUTOINCREMENT, "feedURL" TEXT NOT NULL UNIQUE, "title" TEXT, "author" TEXT, "synopsis" TEXT, "artworkURL" TEXT, "etag" TEXT, "lastModified" TEXT, "subscribedAt" DATETIME NOT NULL, "lastRefreshedAt" DATETIME, "refreshGeneration" INTEGER NOT NULL DEFAULT 0, "customSortIndex" INTEGER, "podcastFeedFingerprint" TEXT, "language" TEXT, "lastRefreshAttemptAt" DATETIME)
table	rssFeedRecovery	CREATE TABLE "rssFeedRecovery" ("feedId" INTEGER PRIMARY KEY REFERENCES "rssFeed"("id") ON DELETE CASCADE, "reason" TEXT NOT NULL CHECK ("reason" = 'credentialStorageFailed'), "createdAt" DATETIME NOT NULL)
table	rssFeedSettings	CREATE TABLE "rssFeedSettings" ("feedId" INTEGER PRIMARY KEY REFERENCES "rssFeed"("id") ON DELETE CASCADE, "autoDownload" TEXT NOT NULL DEFAULT 'inherit', "keepLatest" INTEGER, "deleteAfterPlayed" BOOLEAN, "rateStep" INTEGER, "includeInLatest" BOOLEAN NOT NULL DEFAULT 1, notificationOverride TEXT NOT NULL DEFAULT 'inherit' CHECK (notificationOverride IN ('inherit', 'enabled', 'disabled')), trimSilencesOverride TEXT NOT NULL DEFAULT 'inherit' CHECK (trimSilencesOverride IN ('inherit', 'off', 'moderate', 'maximum')), voiceBoostOverride TEXT NOT NULL DEFAULT 'inherit' CHECK (voiceBoostOverride IN ('inherit', 'on', 'off')), CHECK (autoDownload IN ('inherit', 'enabled', 'disabled')))
table	rssListeningQueueEntry	CREATE TABLE "rssListeningQueueEntry" ("id" INTEGER PRIMARY KEY AUTOINCREMENT, "rssEpisodeId" INTEGER NOT NULL REFERENCES "rssEpisode"("id") ON DELETE CASCADE, "position" INTEGER NOT NULL, "downloadDeclinedAt" DATETIME, UNIQUE ("rssEpisodeId"), UNIQUE ("position"))
table	rssNotificationFeedBaseline	CREATE TABLE "rssNotificationFeedBaseline" ("feedId" INTEGER PRIMARY KEY REFERENCES "rssFeed"("id") ON DELETE CASCADE, "establishedAt" DATETIME NOT NULL)
table	rssPlaybackBookmark	CREATE TABLE "rssPlaybackBookmark" ("id" INTEGER PRIMARY KEY CHECK ("id" = 0), "episodeId" INTEGER NOT NULL REFERENCES "rssEpisode"("id") ON DELETE CASCADE, "updatedAt" DATETIME NOT NULL)
table	rssSavedShelfEntry	CREATE TABLE "rssSavedShelfEntry" ("id" INTEGER PRIMARY KEY AUTOINCREMENT, "rssEpisodeId" INTEGER NOT NULL REFERENCES "rssEpisode"("id") ON DELETE CASCADE, "savedAt" DATETIME NOT NULL, "subjectTitle" TEXT NOT NULL DEFAULT '', "contextTitle" TEXT)
table	rssShowOrder	CREATE TABLE "rssShowOrder" ("id" INTEGER PRIMARY KEY CHECK ("id" = 0), "mode" TEXT NOT NULL)
table	rssWatchCopy	CREATE TABLE "rssWatchCopy" ("episodeId" INTEGER PRIMARY KEY REFERENCES "rssEpisode"("id") ON DELETE CASCADE, "watchInstallID" TEXT, "revision" INTEGER NOT NULL, "state" TEXT NOT NULL, "removedBy" TEXT, "declineReason" TEXT, "sourceBytes" INTEGER, "requestedAt" DATETIME NOT NULL, "updatedAt" DATETIME NOT NULL, "failedAt" DATETIME, CHECK (revision >= 1), CHECK (state IN ('wanted', 'waitingForDownload', 'waitingForWatch', 'sending', 'delivering', 'delivered', 'removed', 'declined', 'failed')), CHECK (removedBy IS NULL OR removedBy IN ('phone', 'watch')), CHECK ((state = 'removed') = (removedBy IS NOT NULL)), CHECK (declineReason IS NULL OR declineReason IN ('storageFull', 'invalid', 'signedOut')), CHECK ((state = 'declined') = (declineReason IS NOT NULL)))
table	rssWatchCopySet	CREATE TABLE "rssWatchCopySet" ("id" INTEGER PRIMARY KEY, "watchInstallID" TEXT, "generation" INTEGER NOT NULL DEFAULT 0, "acknowledgedGeneration" INTEGER NOT NULL DEFAULT 0, "inventorySequence" INTEGER NOT NULL DEFAULT 0, "acceptsCopies" BOOLEAN, "budgetTotalBytes" INTEGER, "budgetUsedBytes" INTEGER, "lastInventoryAt" DATETIME, "absGeneration" INTEGER NOT NULL DEFAULT 0, "absAcknowledgedGeneration" INTEGER NOT NULL DEFAULT 0, "absInventorySequence" INTEGER NOT NULL DEFAULT 0, "absWatchInstallID" TEXT, "absInventoryAccountHash" TEXT, CHECK (id = 1))
table	savedShelfEntry	CREATE TABLE "savedShelfEntry" ("id" INTEGER PRIMARY KEY AUTOINCREMENT, "accountId" INTEGER NOT NULL REFERENCES "account"("id") ON DELETE CASCADE, "itemId" INTEGER NOT NULL, "podcastEpisodeId" INTEGER, "savedAt" DATETIME NOT NULL, "subjectTitle" TEXT NOT NULL DEFAULT '', "contextTitle" TEXT, FOREIGN KEY ("accountId", "itemId") REFERENCES "item"("accountId", "id") ON DELETE CASCADE, FOREIGN KEY ("accountId", "podcastEpisodeId") REFERENCES "podcastEpisode"("accountId", "id") ON DELETE CASCADE, CHECK (itemId IS NOT NULL))
table	smartList	CREATE TABLE "smartList" ("id" INTEGER PRIMARY KEY AUTOINCREMENT, "name" TEXT NOT NULL, "position" INTEGER NOT NULL UNIQUE, "showScope" TEXT NOT NULL CHECK (showScope IN ('all', 'allExcept', 'only')), "includeUnplayed" BOOLEAN NOT NULL, "includeInProgress" BOOLEAN NOT NULL, "includePlayed" BOOLEAN NOT NULL, "includeDownloaded" BOOLEAN NOT NULL, "includeNotDownloaded" BOOLEAN NOT NULL, "savedOnly" BOOLEAN NOT NULL DEFAULT 0, "publishedWithinHours" INTEGER CHECK (publishedWithinHours IS NULL OR publishedWithinHours IN (24, 72, 168, 336, 744)), "durationFilter" BOOLEAN NOT NULL DEFAULT 0, "longerThanMinutes" INTEGER NOT NULL, "shorterThanMinutes" INTEGER NOT NULL, "sortOrder" TEXT NOT NULL CHECK (sortOrder IN ('newest', 'oldest', 'shortest', 'longest')), "autoDownload" BOOLEAN NOT NULL DEFAULT 0, "autoDownloadLimit" INTEGER NOT NULL CHECK (autoDownloadLimit IN (5, 10, 20, 40, 100)) DEFAULT 10, "createdAt" DATETIME NOT NULL, "updatedAt" DATETIME NOT NULL, CHECK (includeUnplayed OR includeInProgress OR includePlayed), CHECK (includeDownloaded OR includeNotDownloaded))
table	smartListDownloadClaim	CREATE TABLE "smartListDownloadClaim" ("listId" INTEGER NOT NULL REFERENCES "smartList"("id") ON DELETE CASCADE, "itemID" TEXT NOT NULL, "episodeID" TEXT NOT NULL, "accountId" INTEGER REFERENCES "account"("id") ON DELETE CASCADE, "claimedAt" DATETIME NOT NULL, PRIMARY KEY ("listId", "itemID", "episodeID"))
table	smartListDownloadDecline	CREATE TABLE "smartListDownloadDecline" ("itemID" TEXT NOT NULL, "episodeID" TEXT NOT NULL, "accountId" INTEGER REFERENCES "account"("id") ON DELETE CASCADE, "declinedAt" DATETIME NOT NULL, PRIMARY KEY ("itemID", "episodeID"))
table	smartListHiddenEpisode	CREATE TABLE "smartListHiddenEpisode" ("listId" INTEGER NOT NULL REFERENCES "smartList"("id") ON DELETE CASCADE, "itemID" TEXT NOT NULL, "episodeID" TEXT NOT NULL, PRIMARY KEY ("listId", "itemID", "episodeID"))
table	smartListRun	CREATE TABLE "smartListRun" ("id" INTEGER PRIMARY KEY CHECK (id = 1), "listId" INTEGER NOT NULL REFERENCES "smartList"("id") ON DELETE CASCADE, "anchorItemID" TEXT, "anchorEpisodeID" TEXT, "anchorSortKey" TEXT, "startedAt" DATETIME NOT NULL)
table	smartListShow	CREATE TABLE "smartListShow" ("listId" INTEGER NOT NULL REFERENCES "smartList"("id") ON DELETE CASCADE, "source" TEXT NOT NULL CHECK (source IN ('native', 'server')), "showKey" TEXT NOT NULL, "role" TEXT NOT NULL CHECK (role IN ('included', 'excluded', 'priority')), "titleSnapshot" TEXT NOT NULL, PRIMARY KEY ("listId", "source", "showKey"))
table	syncPage	CREATE TABLE "syncPage" ("id" INTEGER PRIMARY KEY AUTOINCREMENT, "accountId" INTEGER NOT NULL REFERENCES "account"("id") ON DELETE CASCADE, "syncRunId" INTEGER NOT NULL REFERENCES "syncRun"("id") ON DELETE CASCADE, "pageNumber" INTEGER NOT NULL, "itemCount" INTEGER NOT NULL, "fetchedAt" DATETIME NOT NULL, "resultCategory" TEXT)
table	syncRun	CREATE TABLE "syncRun" ("id" INTEGER PRIMARY KEY AUTOINCREMENT, "accountId" INTEGER NOT NULL REFERENCES "account"("id") ON DELETE CASCADE, "libraryId" INTEGER REFERENCES "library"("id") ON DELETE CASCADE, "reason" TEXT NOT NULL, "generation" INTEGER NOT NULL, "startedAt" DATETIME NOT NULL, "completedAt" DATETIME, "state" TEXT NOT NULL, "errorCategory" TEXT, "sortRequested" TEXT)
trigger	absWatchCopySet_accountDeleted	CREATE TRIGGER absWatchCopySet_accountDeleted AFTER DELETE ON account BEGIN UPDATE rssWatchCopySet SET absInventoryAccountHash = NULL WHERE id = 1; END
trigger	episodeSearch_ad	CREATE TRIGGER episodeSearch_ad AFTER DELETE ON podcastEpisode BEGIN INSERT INTO episodeSearch(episodeSearch, rowid, title, subtitle, episodeDescription) SELECT 'delete', old.id, searchFold(old.title), searchFold(old.subtitle), searchFold(searchPlainText(old.episodeDescription)) WHERE old.softDeleted = 0; END
trigger	episodeSearch_ai	CREATE TRIGGER episodeSearch_ai AFTER INSERT ON podcastEpisode BEGIN INSERT INTO episodeSearch(rowid, title, subtitle, episodeDescription) SELECT new.id, searchFold(new.title), searchFold(new.subtitle), searchFold(searchPlainText(new.episodeDescription)) WHERE new.softDeleted = 0; END
trigger	episodeSearch_au	CREATE TRIGGER episodeSearch_au AFTER UPDATE ON podcastEpisode BEGIN INSERT INTO episodeSearch(episodeSearch, rowid, title, subtitle, episodeDescription) SELECT 'delete', old.id, searchFold(old.title), searchFold(old.subtitle), searchFold(searchPlainText(old.episodeDescription)) WHERE old.softDeleted = 0; INSERT INTO episodeSearch(rowid, title, subtitle, episodeDescription) SELECT new.id, searchFold(new.title), searchFold(new.subtitle), searchFold(searchPlainText(new.episodeDescription)) WHERE new.softDeleted = 0; END
trigger	itemSearch_ad	CREATE TRIGGER itemSearch_ad AFTER DELETE ON item BEGIN INSERT INTO itemSearch(itemSearch, rowid, title, author, seriesName, narratorName) SELECT 'delete', old.id, searchFold(old.title), searchFold(old.author), searchFold(old.seriesName), searchFold(old.narratorName) WHERE old.softDeleted = 0; END
trigger	itemSearch_ai	CREATE TRIGGER itemSearch_ai AFTER INSERT ON item BEGIN INSERT INTO itemSearch(rowid, title, author, seriesName, narratorName) SELECT new.id, searchFold(new.title), searchFold(new.author), searchFold(new.seriesName), searchFold(new.narratorName) WHERE new.softDeleted = 0; END
trigger	itemSearch_au	CREATE TRIGGER itemSearch_au AFTER UPDATE ON item WHEN old.softDeleted IS NOT new.softDeleted OR old.title IS NOT new.title OR old.author IS NOT new.author OR old.seriesName IS NOT new.seriesName OR old.narratorName IS NOT new.narratorName BEGIN INSERT INTO itemSearch(itemSearch, rowid, title, author, seriesName, narratorName) SELECT 'delete', old.id, searchFold(old.title), searchFold(old.author), searchFold(old.seriesName), searchFold(old.narratorName) WHERE old.softDeleted = 0; INSERT INTO itemSearch(rowid, title, author, seriesName, narratorName) SELECT new.id, searchFold(new.title), searchFold(new.author), searchFold(new.seriesName), searchFold(new.narratorName) WHERE new.softDeleted = 0; END
trigger	podcastCloudDirty_nativePodcastSettings_ai	CREATE TRIGGER podcastCloudDirty_nativePodcastSettings_ai AFTER INSERT ON nativePodcastSettings BEGIN INSERT INTO podcastCloudDirty (kind, key) SELECT 'globals', '' WHERE NOT EXISTS (SELECT 1 FROM podcastCloudDirty WHERE kind = 'globals' AND key = ''); END
trigger	podcastCloudDirty_nativePodcastSettings_au	CREATE TRIGGER podcastCloudDirty_nativePodcastSettings_au AFTER UPDATE ON nativePodcastSettings BEGIN INSERT INTO podcastCloudDirty (kind, key) SELECT 'globals', '' WHERE NOT EXISTS (SELECT 1 FROM podcastCloudDirty WHERE kind = 'globals' AND key = ''); END
trigger	podcastCloudDirty_rssEpisodeState_ai	CREATE TRIGGER podcastCloudDirty_rssEpisodeState_ai AFTER INSERT ON rssEpisodeState BEGIN INSERT INTO podcastCloudDirty (kind, key) SELECT 'state', CAST(NEW.episodeId AS TEXT) WHERE NOT EXISTS (SELECT 1 FROM podcastCloudDirty WHERE kind = 'state' AND key = CAST(NEW.episodeId AS TEXT)); END
trigger	podcastCloudDirty_rssEpisodeState_au	CREATE TRIGGER podcastCloudDirty_rssEpisodeState_au AFTER UPDATE ON rssEpisodeState BEGIN INSERT INTO podcastCloudDirty (kind, key) SELECT 'state', CAST(NEW.episodeId AS TEXT) WHERE NOT EXISTS (SELECT 1 FROM podcastCloudDirty WHERE kind = 'state' AND key = CAST(NEW.episodeId AS TEXT)); END
trigger	podcastCloudDirty_rssFeedSettings_ai	CREATE TRIGGER podcastCloudDirty_rssFeedSettings_ai AFTER INSERT ON rssFeedSettings BEGIN INSERT INTO podcastCloudDirty (kind, key) SELECT 'settings', CAST(NEW.feedId AS TEXT) WHERE NOT EXISTS (SELECT 1 FROM podcastCloudDirty WHERE kind = 'settings' AND key = CAST(NEW.feedId AS TEXT)); END
trigger	podcastCloudDirty_rssFeedSettings_au	CREATE TRIGGER podcastCloudDirty_rssFeedSettings_au AFTER UPDATE ON rssFeedSettings BEGIN INSERT INTO podcastCloudDirty (kind, key) SELECT 'settings', CAST(NEW.feedId AS TEXT) WHERE NOT EXISTS (SELECT 1 FROM podcastCloudDirty WHERE kind = 'settings' AND key = CAST(NEW.feedId AS TEXT)); END
trigger	podcastCloudDirty_rssFeed_ad	CREATE TRIGGER podcastCloudDirty_rssFeed_ad AFTER DELETE ON rssFeed BEGIN INSERT INTO podcastCloudDirty (kind, key) SELECT 'sub', OLD.feedURL WHERE NOT EXISTS (SELECT 1 FROM podcastCloudDirty WHERE kind = 'sub' AND key = OLD.feedURL); END
trigger	podcastCloudDirty_rssFeed_ai	CREATE TRIGGER podcastCloudDirty_rssFeed_ai AFTER INSERT ON rssFeed BEGIN INSERT INTO podcastCloudDirty (kind, key) SELECT 'sub', NEW.feedURL WHERE NOT EXISTS (SELECT 1 FROM podcastCloudDirty WHERE kind = 'sub' AND key = NEW.feedURL); END
trigger	podcastCloudDirty_rssFeed_au	CREATE TRIGGER podcastCloudDirty_rssFeed_au AFTER UPDATE OF customSortIndex ON rssFeed WHEN NEW.customSortIndex IS NOT OLD.customSortIndex BEGIN INSERT INTO podcastCloudDirty (kind, key) SELECT 'sub', NEW.feedURL WHERE NOT EXISTS (SELECT 1 FROM podcastCloudDirty WHERE kind = 'sub' AND key = NEW.feedURL); END
trigger	podcastCloudDirty_rssPlaybackBookmark_ai	CREATE TRIGGER podcastCloudDirty_rssPlaybackBookmark_ai AFTER INSERT ON rssPlaybackBookmark BEGIN INSERT INTO podcastCloudDirty (kind, key) SELECT 'bookmark', '' WHERE NOT EXISTS (SELECT 1 FROM podcastCloudDirty WHERE kind = 'bookmark' AND key = ''); END
trigger	podcastCloudDirty_rssPlaybackBookmark_au	CREATE TRIGGER podcastCloudDirty_rssPlaybackBookmark_au AFTER UPDATE ON rssPlaybackBookmark BEGIN INSERT INTO podcastCloudDirty (kind, key) SELECT 'bookmark', '' WHERE NOT EXISTS (SELECT 1 FROM podcastCloudDirty WHERE kind = 'bookmark' AND key = ''); END
trigger	podcastCloudDirty_rssSavedShelfEntry_ad	CREATE TRIGGER podcastCloudDirty_rssSavedShelfEntry_ad AFTER DELETE ON rssSavedShelfEntry BEGIN INSERT INTO podcastCloudDirty (kind, key) SELECT 'saved', CAST(OLD.rssEpisodeId AS TEXT) WHERE NOT EXISTS (SELECT 1 FROM podcastCloudDirty WHERE kind = 'saved' AND key = CAST(OLD.rssEpisodeId AS TEXT)); END
trigger	podcastCloudDirty_rssSavedShelfEntry_ai	CREATE TRIGGER podcastCloudDirty_rssSavedShelfEntry_ai AFTER INSERT ON rssSavedShelfEntry BEGIN INSERT INTO podcastCloudDirty (kind, key) SELECT 'saved', CAST(NEW.rssEpisodeId AS TEXT) WHERE NOT EXISTS (SELECT 1 FROM podcastCloudDirty WHERE kind = 'saved' AND key = CAST(NEW.rssEpisodeId AS TEXT)); END
trigger	podcastCloudDirty_rssShowOrder_ai	CREATE TRIGGER podcastCloudDirty_rssShowOrder_ai AFTER INSERT ON rssShowOrder BEGIN INSERT INTO podcastCloudDirty (kind, key) SELECT 'globals', '' WHERE NOT EXISTS (SELECT 1 FROM podcastCloudDirty WHERE kind = 'globals' AND key = ''); END
trigger	podcastCloudDirty_rssShowOrder_au	CREATE TRIGGER podcastCloudDirty_rssShowOrder_au AFTER UPDATE ON rssShowOrder BEGIN INSERT INTO podcastCloudDirty (kind, key) SELECT 'globals', '' WHERE NOT EXISTS (SELECT 1 FROM podcastCloudDirty WHERE kind = 'globals' AND key = ''); END
trigger	savedShelfProgress_ai	CREATE TRIGGER savedShelfProgress_ai AFTER INSERT ON mediaProgress WHEN COALESCE(NEW.currentTime, 0) > 0 OR COALESCE(NEW.ebookProgress, 0) > 0 OR NEW.isFinished = 1 BEGIN DELETE FROM savedShelfEntry WHERE accountId = NEW.accountId AND itemId = NEW.itemId AND ( (NEW.podcastEpisodeId IS NULL AND podcastEpisodeId IS NULL) OR podcastEpisodeId = NEW.podcastEpisodeId ); END
trigger	savedShelfProgress_au	CREATE TRIGGER savedShelfProgress_au AFTER UPDATE OF currentTime, ebookProgress, readingPositionJSON, isFinished ON mediaProgress WHEN ( (COALESCE(NEW.currentTime, 0) > 0 OR COALESCE(NEW.ebookProgress, 0) > 0) AND ( NEW.currentTime IS NOT OLD.currentTime OR NEW.ebookProgress IS NOT OLD.ebookProgress OR NEW.readingPositionJSON IS NOT OLD.readingPositionJSON ) ) OR (NEW.isFinished = 1 AND OLD.isFinished = 0) BEGIN DELETE FROM savedShelfEntry WHERE accountId = NEW.accountId AND itemId = NEW.itemId AND ( (NEW.podcastEpisodeId IS NULL AND podcastEpisodeId IS NULL) OR podcastEpisodeId = NEW.podcastEpisodeId ); END
